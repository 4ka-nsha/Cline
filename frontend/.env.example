# Data source mode: "mock" (default) or "live".
# In "live" mode the app calls the backend at VITE_API_BASE_URL and surfaces
# any request errors (it never silently falls back to mock data).
VITE_DATA_MODE=mock

# Public, non-secret backend base URL used only in "live" mode.
# NEVER put API keys or secrets here — Vite inlines VITE_* into the public bundle.
VITE_API_BASE_URL=http://localhost:8000
