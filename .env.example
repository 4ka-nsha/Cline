# KrishiFlow environment variables
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# --- Server ---
PORT=4000
NODE_ENV=development

# SQLite database file (relative to the server workspace, or an absolute path)
DATABASE_PATH=./data/krishiflow.db

# --- Live data sources (NOT YET WIRED - weather + market come later) ---
# data.gov.in API key: https://data.gov.in -> API -> Generate API Key
DATA_GOV_IN_API_KEY=

# Open-Meteo has no key, but override for testing
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# --- Feature switches ---
# Never let demo data substitute for live data silently.
# When false (default) a failed live request must surface an error.
ALLOW_DEMO_DATA_FALLBACK=false
