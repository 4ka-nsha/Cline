# KrishiFlow web (frontend) settings.
# Copy to `web/.env` and adjust. Only non-secret values here —
# Vite inlines VITE_* into the public bundle; NEVER put API keys in them.

# Explicit data mode: "mock" (sample data) or "live" (real backend).
VITE_DATA_MODE=mock

# Public backend base URL used only in "live" mode.
VITE_API_BASE_URL=http://localhost:4000

